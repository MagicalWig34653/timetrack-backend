# Copy to .env via `scripts/dev-env.sh init` (generates random dev passwords).
# Placeholder values only; never commit a real .env.

# --- MariaDB container (compose service `db`) ---
DB_ROOT_PASSWORD=change-me-root
DB_NAME=timetrack
DB_USER=timetrack
DB_PASSWORD=change-me-app
# Host port (bound to 127.0.0.1 only)
DB_HOST_PORT=13306

# --- Backend configuration (ADR-0003) ---
DATABASE_DRIVER=mariadb
DB_HOST=db
DB_PORT=3306
DB_TLS=false
SQLITE_PATH=/data/timetrack.sqlite
AUTO_MIGRATE=true
SESSION_TTL_HOURS=336
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Timetrack (dev)
WEBAUTHN_ORIGIN=http://localhost:18080
PUBLIC_BASE_URL=http://localhost:18080
# Host port of the backend (bound to 127.0.0.1 only)
BACKEND_HOST_PORT=18080

# --- Static PWA (production-like profile, no Node at runtime) ---
# Host directory with the built PWA (e.g. ../timetrack-pwa/build); mounted read-only at /srv/pwa.
PWA_STATIC_HOST_DIR=./deploy/pwa-empty
PWA_STATIC_DIR=/srv/pwa

# --- Mailpit (profile `mail`) ---
MAIL_UI_HOST_PORT=18025
SMTP_HOST=mailpit
SMTP_PORT=1025
