# Copy to .env via `scripts/dev-env.sh init` (generates random dev passwords).
# Placeholder values only; never commit a real .env.

# --- MariaDB container (compose service `db`) ---
DB_ROOT_PASSWORD=change-me-root
DB_NAME=timetrack
DB_USER=timetrack
DB_PASSWORD=change-me-app
# Host port; bind address defaults to 127.0.0.1. Do not expose the database.
DB_HOST_PORT=13306
# DB_BIND_ADDR=127.0.0.1

# --- Backend configuration (ADR-0003) ---
DATABASE_DRIVER=mariadb
DB_HOST=db
DB_PORT=3306
DB_TLS=off
SQLITE_PATH=/data/timetrack.sqlite
AUTO_MIGRATE=true
SESSION_TTL_HOURS=336
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Timetrack (dev)
WEBAUTHN_ORIGIN=http://localhost:18080
PUBLIC_BASE_URL=http://localhost:18080
# Native Apple apps (passkeys via Associated Domains): comma separated <TeamID>.<BundleID>. Empty = endpoint
# /.well-known/apple-app-site-association answers 404. Example:
# APPLE_APP_IDS=ABCDE12345.com.example.timetrack
# Host port and bind address of the backend. Default 127.0.0.1 (local only).
# To let an existing reverse proxy reach it set BACKEND_BIND_ADDR=0.0.0.0 (or a LAN IP) and use the
# public https values for PUBLIC_BASE_URL / WEBAUTHN_ORIGIN / WEBAUTHN_RP_ID (see docs/TESTUMGEBUNGEN.md).
BACKEND_HOST_PORT=18080
BACKEND_BIND_ADDR=127.0.0.1

# --- Static PWA (production-like profile, no Node at runtime) ---
# Host directory with the built PWA (e.g. ../timetrack-pwa/build); mounted read-only at /srv/pwa.
PWA_STATIC_HOST_DIR=./deploy/pwa-empty
PWA_STATIC_DIR=/srv/pwa

# --- Mailpit (profile `mail`) ---
MAIL_UI_HOST_PORT=18025
MAIL_SMTP_HOST_PORT=11025
MAIL_BIND_ADDR=127.0.0.1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=off
SMTP_FROM=noreply@example.test

# --- Adobe S3Mock (profile `s3`); accepts any credentials ---
S3_BUCKET=timetrack-dev
S3_HTTP_HOST_PORT=19090
S3_HTTPS_HOST_PORT=19191
S3_BIND_ADDR=127.0.0.1

# --- Dex OIDC test provider (profile `oidc`) ---
OIDC_HOST_PORT=15556
OIDC_BIND_ADDR=127.0.0.1

# base64 of 32 random bytes; encrypts S3 secrets at rest. Losing it makes stored S3 secrets unusable.
STORAGE_SECRET_KEY=

# --- Notifications and Web Push (ADR-0010) ---
# Background reminder runner; set to false to disable (in-app list and REST keep working).
NOTIFICATIONS_ENABLED=true
# Web Push needs both values. Empty = push unavailable (GET /api/v1/push/config -> available:false). Generate the key with
# openssl ecparam -name prime256v1 -genkey -noout | openssl ec -outform DER 2>/dev/null | tail -c +8 | head -c 32 | base64 | tr '+/' '-_' | tr -d '=\n'
VAPID_PRIVATE_KEY=
# mailto:you@example.test or https://example.test/contact
VAPID_SUBJECT=
# Optional: replaces the built-in push service allow-list (ADR-0011). Tested suggestion, one pattern per push service:
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com
PUSH_ALLOWED_HOSTS=

# --- Maintenance job (ADR-0017) ---
# Minutes between periodic cleanups of expired sessions, codes, tokens, rate-limit events, audit rows, stuck imports and orphaned files; 0 = off.
# `App maintenance` runs the same job once (cron/ops) and is safe next to running replicas.
MAINTENANCE_INTERVAL_MINUTES=60
MCP_AUDIT_RETENTION_DAYS=90
IMPORT_JOB_TIMEOUT_HOURS=168
STORAGE_ORPHAN_GRACE_HOURS=168

# Optional operator lock: reports,planning,transfer,automation,mcp
# MODULES_DISABLED=reports,mcp
