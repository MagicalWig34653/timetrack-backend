# Timetrack Compose setup: copy to .env (Compose reads it automatically). Never commit the real .env.
# Passwords and keys are NOT set here: they live in ./secrets/ (run ./init-secrets.sh).

# --- REQUIRED ---
# Public multi-arch image (the PWA is part of it). Pin a version for production, e.g. :0.1.0 (or :sha-<short>);
# :latest follows the newest development state. Build it yourself: docs/IMAGE-BAUEN.md
TIMETRACK_IMAGE=ghcr.io/magicalwig34653/timetrack-backend:latest
# MariaDB host. With the optional bundled database (docker compose --profile db up -d) use: db  (and DB_TLS=off)
DB_HOST=mariadb.example.org
# Public address and passkey domain. The RP ID cannot be changed later without invalidating all passkeys.
PUBLIC_BASE_URL=https://timetrack.example.org
WEBAUTHN_RP_ID=timetrack.example.org
WEBAUTHN_ORIGIN=https://timetrack.example.org
# Contact for push services: mailto: or https:
VAPID_SUBJECT=mailto:admin@example.org

# --- OPTIONAL (defaults shown) ---
DB_PORT=3306
DB_NAME=timetrack
DB_USER=timetrack
# required = TLS with certificate check | off = no TLS (only for a trusted/local network, e.g. the bundled db)
DB_TLS=required
WEBAUTHN_RP_NAME=Timetrack
# Address and port on the host. 127.0.0.1 (default) if the reverse proxy runs on this host. For a proxy on another host use
# this host's private address (or 0.0.0.0) AND firewall the port so that only the proxy can reach it (SEC-01/SEC-13).
BIND_ADDR=127.0.0.1
PUBLISHED_PORT=18080
# REQUIRED behind a reverse proxy: network(s)/address(es) that may report the client address via X-Forwarded-For (as narrow as
# possible, ideally the proxy address as /32). Empty: all clients share ONE address-based rate limit and lockout.
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HEADER=X-Forwarded-For
# iOS/macOS app: <TeamID>.<BundleID>; empty = apple-app-site-association answers 404
APPLE_APP_IDS=
MODULES_DISABLED=

# --- Everything else is optional; empty = not set. Every variable below is passed to the backend (compose.yaml). ---
# Each feature has a switch <FEATURE>_ENABLED: true = must run (incomplete = start error), false = off, empty = automatic
# (on when its required variables are set). The start-up log lists all features. Reference: docs/installation/konfiguration.md
APPLE_APP_IDS_ENABLED=
WEB_PUSH_ENABLED=
PUSH_ALLOWED_HOSTS=
NOTIFICATIONS_ENABLED=true
# APNs for the Apple apps (key: secrets/tt_apns_private_key)
APNS_ENABLED=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_IDS=
# E-mail (password: secrets/tt_smtp_password; the Mailpit test server is in the dev compose file, not here)
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_FROM_NAME=Timetrack
SMTP_USER=
# OpenID Connect (client secret: secrets/tt_oidc_client_secret)
OIDC_ENABLED=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_NAME="OpenID Connect"
OIDC_SCOPES="openid email profile"
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=336
HSTS_MAX_AGE_SECONDS=15552000
STORAGE_S3_ALLOWED_HOSTS=
STORAGE_LOCAL_ROOT=
PWA_CSP_MODE=enforce
