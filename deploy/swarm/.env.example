# Variables for deploy/swarm/stack.yaml. Copy to .env (not committed), replace the EXAMPLE values.
# Use:  set -a; . ./.env; set +a; docker stack deploy --with-registry-auth -c stack.yaml timetrack
# This file controls EVERYTHING: stack.yaml passes every variable to the backend, an EMPTY value counts as "not set", and the
# backend decides which optional features run. Each feature has an optional switch <FEATURE>_ENABLED:
#   true  = must run (incomplete configuration = start error with a clear message)
#   false = off, whatever else is set
#   empty = automatic: on when its required variables are set (the default)
# The start-up log lists every feature (on/off and why). Full reference: docs/installation/konfiguration.md.
# Passwords and keys do NOT belong here: they are Docker secrets (create-secrets.sh, docs/DEPLOYMENT.md).
# The file is sourced by a POSIX shell: no spaces around "=", quote values with spaces or special characters.

# ===== REQUIRED =====
# Public multi-arch image. Pin a version for production, e.g. :0.1.0 (or :sha-<short>); :latest follows the newest development state.
# Own registry: `docker login`, deploy with --with-registry-auth (docs/IMAGE-BAUEN.md).
TIMETRACK_IMAGE=ghcr.io/magicalwig34653/timetrack-backend:latest
# Existing MariaDB (outside this stack). With DB_TLS=required the name must match the server certificate.
DB_HOST=db.internal.example.test
# Public address. The host is the passkey relying party and CANNOT be changed later without invalidating all passkeys.
PUBLIC_BASE_URL=https://timetrack.example.test
WEBAUTHN_RP_ID=timetrack.example.test
WEBAUTHN_ORIGIN=https://timetrack.example.test

# ===== Database (optional, defaults shown) =====
DB_PORT=3306
DB_NAME=timetrack
DB_USER=timetrack
# required (default, certificate is verified against the system CA bundle of the image) | off
DB_TLS=required
# Connections per CPU core and replica (1..8), wait for a free connection (s), ping interval against dropped idle connections (s, 0 = off)
DB_POOL_CONNECTIONS_PER_LOOP=1
DB_POOL_TIMEOUT_SECONDS=10
DB_KEEPALIVE_SECONDS=45

# ===== Network, proxy, login (optional) =====
WEBAUTHN_RP_NAME=Timetrack
# TCP port published on every Swarm node (routing mesh). The reverse proxy connects to <any-node>:PUBLISHED_PORT.
PUBLISHED_PORT=18080
# Subnet(s) the backend should trust for X-Forwarded-For: behind the routing mesh that is the ingress network:
#   docker network inspect ingress --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# IMPORTANT: firewall PUBLISHED_PORT so only your reverse proxy can reach it (otherwise clients could forge X-Forwarded-For).
# Without it all clients behind the proxy share one rate-limit bucket (docs/DEPLOYMENT.md, docs/BETRIEB.md section 6).
TRUSTED_PROXY_CIDRS=10.0.0.0/24
TRUSTED_PROXY_HEADER=X-Forwarded-For
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=336
HSTS_MAX_AGE_SECONDS=15552000
# Emergency brake for the Content-Security-Policy of the PWA: enforce (default) | report-only | off (docs/BETRIEB.md, section 6)
PWA_CSP_MODE=enforce

# ===== Apple apps: apple-app-site-association =====
# true | false | empty = on when APPLE_APP_IDS is set
APPLE_APP_IDS_ENABLED=
# <TeamID>.<BundleID>, comma separated. ABCDE12345 is a PLACEHOLDER (10 characters A-Z/0-9): use your own Apple Team ID.
APPLE_APP_IDS=ABCDE12345.com.example.timetrack

# ===== Web Push (VAPID key = Docker secret tt_vapid_private_key) =====
# true | false | empty = on when the key (secret) and VAPID_SUBJECT are set
WEB_PUSH_ENABLED=
# Contact for push services (mailto: or https: URI).
VAPID_SUBJECT=mailto:admin@example.test
# Replaces the built-in push-service allow-list (ADR-0011); tested suggestion. Empty = built-in list.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com
# Background reminder runner: true | false
NOTIFICATIONS_ENABLED=true

# ===== APNs push for the Apple apps, ADR-0030 (key = Docker secret tt_apns_private_key) =====
# true | false | empty = on when key (secret), key ID, team ID and bundle IDs are all set. ABCDE12345 is a PLACEHOLDER.
APNS_ENABLED=
APNS_KEY_ID=
APNS_TEAM_ID=
# comma separated, for example com.example.timetrack
APNS_BUNDLE_IDS=

# ===== E-mail (recovery codes); password = Docker secret tt_smtp_password =====
# true | false | empty = on when SMTP_HOST is set (then SMTP_FROM is required)
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
# starttls | implicit ("off" only for loopback test hosts)
SMTP_TLS=starttls
SMTP_FROM=
SMTP_FROM_NAME=Timetrack
# With authentication: SMTP_USER AND the real password in the secret tt_smtp_password. Without: leave empty.
SMTP_USER=

# ===== OpenID Connect login; client secret = Docker secret tt_oidc_client_secret (optional for public clients) =====
# true | false | empty = on when OIDC_ISSUER and OIDC_CLIENT_ID are set
OIDC_ENABLED=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_NAME="OpenID Connect"
OIDC_SCOPES="openid email profile"

# ===== Files: S3 and local storage rules are set in the admin UI (S3 credentials are encrypted with the secret tt_storage_secret_key) =====
# Optional hardening: only these exact S3 endpoint host names / only paths below this directory. Empty = no restriction.
STORAGE_S3_ALLOWED_HOSTS=
STORAGE_LOCAL_ROOT=

# ===== Modules and maintenance =====
# Operator lock for modules: reports,planning,transfer,automation,mcp,groups (empty = all on)
MODULES_DISABLED=
MAINTENANCE_INTERVAL_MINUTES=60
MCP_AUDIT_RETENTION_DAYS=90
GROUPS_RETENTION_DAYS=90
IMPORT_JOB_TIMEOUT_HOURS=168
STORAGE_ORPHAN_GRACE_HOURS=168
# UTC time stamp at the start of every log line (false = off)
LOG_TIMESTAMPS=true

# ===== Swarm =====
# First deployment: set 0, wait until the migrate job is Complete, then `docker service scale timetrack_backend=1`.
BACKEND_REPLICAS=1
# Optional placement constraint. No pinning is needed (PWA is in the image, files live in the database).
# Example to restrict to a labelled node: BACKEND_PLACEMENT="node.labels.timetrack == true"
BACKEND_PLACEMENT="node.platform.os == linux"
# Extra hard constraints for the backend (Compose cannot split lists: up to three slots, empty = no effect).
# PLACEMENT_CONSTRAINT_1=node.role==worker
# PLACEMENT_CONSTRAINT_2=node.labels.disk==ssd
# PLACEMENT_CONSTRAINT_3=
# Soft preference (spread over a node label, no guarantee); empty = spread by OS (no effect on Linux-only clusters).
# PLACEMENT_SPREAD=node.labels.zone
# Guarantee at least one backend container on a node: second service backend-pinned (hostname). Active only when BOTH are
# set (PINNED_REPLICAS defaults to 0 = off). It publishes no port by default (override.example.yaml).
# PINNED_NODE=worker-a
# PINNED_REPLICAS=1
# Opt-in nodes: adds node.labels.<label>!=true to backend and migrate, so a node labelled <label>=true gets containers only on
# explicit request (backend-pinned is exempt). Convention, no hard protection (hard: docker node update --availability drain).
# EXCLUDE_LABEL=reserved
# Names of the Docker secrets (defaults shown). Change one only to replace a secret: Docker secrets are immutable, so
# create the new one under a new name (create-secrets.sh --name-suffix _2 prints the line) and point the variable at it.
# SECRET_DB_PASSWORD_NAME=tt_db_password
# SECRET_STORAGE_KEY_NAME=tt_storage_secret_key
# SECRET_VAPID_KEY_NAME=tt_vapid_private_key
# SECRET_SMTP_PASSWORD_NAME=tt_smtp_password
# SECRET_OIDC_CLIENT_SECRET_NAME=tt_oidc_client_secret
# SECRET_APNS_KEY_NAME=tt_apns_private_key
