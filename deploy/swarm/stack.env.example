# Variables for deploy/swarm/stack.yaml. Copy to stack.env (not committed), replace the EXAMPLE values.
# Use:  set -a; . deploy/swarm/stack.env; set +a; docker stack deploy --with-registry-auth -c deploy/swarm/stack.yaml timetrack
# Passwords and keys do NOT belong here: they are Docker secrets (deploy/swarm/create-secrets.sh, docs/DEPLOYMENT.md).
# The file is sourced by a POSIX shell: no spaces around "=", quote values with spaces or special characters.
# Never commit the real stack.env if it reveals internal addresses you do not want published.

# ===== REQUIRED =====
# Image from the registry the nodes can pull from (private registry: `docker login`, deploy with --with-registry-auth).
TIMETRACK_IMAGE=ghcr.io/OWNER/timetrack-backend:1.0.0
# Existing MariaDB (outside this stack). With DB_TLS=required the name must match the server certificate.
DB_HOST=db.internal.example.test
# Public address. The host is the passkey relying party and CANNOT be changed later without invalidating all passkeys.
PUBLIC_BASE_URL=https://timetrack.example.test
WEBAUTHN_RP_ID=timetrack.example.test
WEBAUTHN_ORIGIN=https://timetrack.example.test
# Contact for push services (mailto: or https: URI).
VAPID_SUBJECT=mailto:admin@example.test
# Absolute path of the built PWA on the node that runs the backend.
PWA_HOST_DIR=/srv/timetrack/pwa

# ===== OPTIONAL (shown with the default or a recommended example) =====
DB_PORT=3306
DB_NAME=timetrack
DB_USER=timetrack
# required (default, certificate is verified against the system CA bundle of the image) | off
DB_TLS=required
WEBAUTHN_RP_NAME=Timetrack
# Name of the overlay network shared with the reverse proxy (create it first).
PROXY_NETWORK=timetrack-proxy
# Networks of the reverse proxy; get the subnet with: docker network inspect timetrack-proxy --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Without it all clients behind the proxy share one rate-limit bucket (docs/DEPLOYMENT.md, docs/BETRIEB.md section 6).
TRUSTED_PROXY_CIDRS=10.0.1.0/24
TRUSTED_PROXY_HEADER=X-Forwarded-For
# iOS/macOS app: <TeamID>.<BundleID>, comma separated. Empty = /.well-known/apple-app-site-association answers 404.
# ABCDE12345 is a PLACEHOLDER (10 characters A-Z/0-9): use your own Apple Team ID.
APPLE_APP_IDS=ABCDE12345.com.example.timetrack
# Replaces the built-in push-service allow-list (ADR-0011); tested suggestion, one pattern per push service. Empty = built-in list.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com
NOTIFICATIONS_ENABLED=true
SESSION_TTL_HOURS=336
# Operator lock for modules: reports,planning,transfer,automation,mcp (empty = all on)
MODULES_DISABLED=
# Maintenance job (ADR-0017)
MAINTENANCE_INTERVAL_MINUTES=60
MCP_AUDIT_RETENTION_DAYS=90
IMPORT_JOB_TIMEOUT_HOURS=168
STORAGE_ORPHAN_GRACE_HOURS=168
# First deployment: set 0, wait until the migrate job is Complete, then `docker service scale timetrack_backend=1`.
BACKEND_REPLICAS=1
# Local file storage lives in a node-local volume: pin the backend to one node (a node label or hostname works too).
BACKEND_PLACEMENT="node.role == manager"

# ===== OPTIONAL: e-mail recovery (also uncomment the SMTP block and secret in stack.yaml; set ALL of these) =====
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=noreply@example.test
# SMTP_FROM_NAME=Timetrack
# SMTP_USER=timetrack@example.test

# ===== OPTIONAL: OpenID Connect (also uncomment the OIDC block and secret in stack.yaml) =====
# OIDC_ISSUER=https://id.example.test/application/o/timetrack/
# OIDC_CLIENT_ID=timetrack
# OIDC_NAME="Company login"
# OIDC_SCOPES="openid email profile"
