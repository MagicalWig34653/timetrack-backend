# Variables for deploy/swarm/stack.yaml (placeholders only; never commit real values).
# Use:  set -a; . deploy/swarm/stack.env; set +a; docker stack deploy -c deploy/swarm/stack.yaml timetrack
# Passwords and keys do NOT belong here: they are Docker secrets (docs/BETRIEB.md, "Secrets").
TIMETRACK_IMAGE=registry.example.test/timetrack-backend:1.0.0
DB_HOST=db.internal.example.test
DB_PORT=3306
DB_NAME=timetrack
DB_USER=timetrack
DB_TLS=required
WEBAUTHN_RP_ID=timetrack.example.test
WEBAUTHN_ORIGIN=https://timetrack.example.test
PUBLIC_BASE_URL=https://timetrack.example.test
VAPID_SUBJECT=mailto:admin@example.test
PWA_HOST_DIR=/srv/timetrack/pwa
# Optional
# APPLE_APP_IDS=TEAMID1234.de.example.timetrack
# BACKEND_REPLICAS=1
# BACKEND_PLACEMENT=node.role == manager
# PROXY_NETWORK=timetrack-proxy
# SMTP_HOST=smtp.example.test
